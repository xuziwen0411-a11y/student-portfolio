{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "student-portfolio",
  "main": "./cloudflare/worker-entry.js",
  "compatibility_date": "2026-08-28",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "vars": {
    "AUTH_PLATFORM": "password"
  },
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "migrations_dir": "./drizzle","database_id": "dd3248a9-33be-4984-a288-af5cf2faccec","database_name": "student-portfolio"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "MEDIA_KV","id": "161859b7d9b44aaeb6c30a7ea4c92efc"
    }
  ],
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.05
    }
  }
}
